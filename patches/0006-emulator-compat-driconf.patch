From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Amaral Driver Lab <rickamaral94@users.noreply.github.com>
Date: Tue, 1 Sep 2026 00:00:00 +0000
Subject: [PATCH] tu/driconf: isolate Balemuni Zelda profiles by title + Skyrim

Porta o comportamento efetivo encontrado no driconf do binario oficial
Balemuni Apex V2, mas sem copiar sua regra ampla para todos os emuladores.

Adds Skyrim (Switch) and a light engine match for yuzu/eden-family.
Only real upstream Turnip driconf options.

---
 src/freedreno/vulkan/00-turnip-defaults.conf | 50 ++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/src/freedreno/vulkan/00-turnip-defaults.conf b/src/freedreno/vulkan/00-turnip-defaults.conf
--- a/src/freedreno/vulkan/00-turnip-defaults.conf
+++ b/src/freedreno/vulkan/00-turnip-defaults.conf
@@ -69,6 +69,56 @@
              -->
             <option name="tu_allow_oob_indirect_ubo_loads" value="true" />
         </engine>
+        <!-- Perfis reconstruidos do driconf do Balemuni Apex V2. Eles sao
+             deliberadamente condicionados ao titulo, em vez de uma regra
+             ampla por emulador. Isso permite que A6xx, A7xx e A8xx usem a
+             mesma correcao quando o frontend expoe BOTW/TOTK em
+             pApplicationName, sem penalizar os demais jogos. -->
+        <application name="The Legend of Zelda: Breath of the Wild"
+                     application_name_match=".*(botw).*">
+            <option name="tu_enable_fast_border_color_for_undefined_formats" value="true" />
+            <option name="tu_use_tex_coord_round_nearest_even_mode" value="true" />
+            <option name="tu_allow_oob_indirect_ubo_loads" value="true" />
+            <option name="tu_dont_care_as_load" value="true" />
+            <option name="tu_autotune_algorithm" value="prefer_gmem" />
+        </application>
+        <application name="The Legend of Zelda: Tears of the Kingdom"
+                     application_name_match=".*(totk).*">
+            <option name="tu_enable_fast_border_color_for_undefined_formats" value="true" />
+            <option name="tu_use_tex_coord_round_nearest_even_mode" value="true" />
+            <option name="tu_allow_oob_indirect_ubo_loads" value="true" />
+            <option name="tu_dont_care_as_load" value="true" />
+            <option name="tu_autotune_algorithm" value="prefer_gmem" />
+            <option name="tu_ignore_frag_depth_direction" value="true" />
+        </application>
+        <!-- Skyrim (Switch) — Eden / Yuzu -->
+        <application name="The Elder Scrolls V: Skyrim"
+                     application_name_match=".*(Skyrim|skyrim).*">
+            <option name="tu_enable_fast_border_color_for_undefined_formats" value="true" />
+            <option name="tu_use_tex_coord_round_nearest_even_mode" value="true" />
+            <option name="tu_allow_oob_indirect_ubo_loads" value="true" />
+            <option name="tu_dont_care_as_load" value="true" />
+            <option name="tu_autotune_algorithm" value="prefer_gmem" />
+        </application>
+        <!-- Light profile for Switch emulators when title does not match -->
+        <engine engine_name_match="yuzu|suyu|sudachi|citron|eden|storm">
+            <option name="tu_enable_fast_border_color_for_undefined_formats" value="true" />
+            <option name="tu_use_tex_coord_round_nearest_even_mode" value="true" />
+            <option name="tu_allow_oob_indirect_ubo_loads" value="true" />
+            <option name="tu_dont_care_as_load" value="true" />
+        </engine>
         <application name="Sons Of The Forest" application_name_match="SonsOfTheForest.exe">
             <option name="tu_ignore_frag_depth_direction" value="true" />
         </application>
